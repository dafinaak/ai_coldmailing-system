# Beispiel-Nutzerliste fuers Team-Interface.
# Echte Datei liegt als users.yaml im Datenverzeichnis (daten_dir) - NICHT
# im Repo committen, sie enthaelt echte Passwort-Hashes.
#
# Einen neuen Passwort-Hash erzeugen (einmalig, im aktivierten .venv):
#   .venv/bin/python -c "from passlib.context import CryptContext; \
#     print(CryptContext(schemes=['bcrypt']).hash('dein-passwort'))"
#
# Das Beispiel unten passt zum Passwort "bitte-aendern" - nur zum
# Ausprobieren, fuer den echten Betrieb einen eigenen Hash erzeugen.

- name: Lena Hartmann
  passwort_hash: "$2b$12$SblVe6p9Dw9UInzK1w1oHu8TsRYd9QfFx89eIEsuufXFdDB4vIFsC"
