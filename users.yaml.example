# Beispiel-Nutzerliste fürs Team-Interface.
# Echte Datei liegt als users.yaml im Datenverzeichnis (daten_dir) - NICHT
# im Repo committen, sie enthält echte Passwort-Hashes.
#
# Einen neuen Passwort-Hash erzeugen (einmalig, im aktivierten .venv):
#   .venv/bin/python -c "from passlib.context import CryptContext; \
#     print(CryptContext(schemes=['bcrypt']).hash('dein-passwort'))"
#
# Das Beispiel unten passt zum Passwort "bitte-ändern" - nur zum
# Ausprobieren, für den echten Betrieb einen eigenen Hash erzeugen.
#
# Umgebungsvariable WEB_COOKIE_SECURE (in .env, nicht in dieser Datei):
# steuert, ob der Session-Cookie das Secure-Attribut trägt. Default AN -
# Produktion läuft über HTTPS, das gehört dahin. Nur für lokale
# Entwicklung ohne HTTPS auf 0 setzen: WEB_COOKIE_SECURE=0

- name: Lena Hartmann
  passwort_hash: "$2b$12$Ik4.5Apmx2ijr2AXWDXqPu69kwGbF0Wi2Se822XhvPfAERya222xO"
