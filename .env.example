# Firmen finden (Google Maps über Apify)
APIFY_API_KEY=hier-eintragen
# Entscheider finden (Hunter) und persönliche Mail bauen/prüfen (Dropcontact)
HUNTER_API_KEY=hier-eintragen
DROPCONTACT_API_KEY=hier-eintragen
# Anbieter-Vergleich Weg A (pipeline/vergleich.py): Prospeo sucht und prüft alleine
PROSPEO_API_KEY=hier-eintragen
# Für die Text-KI reicht EINER von beiden:
ANTHROPIC_API_KEY=hier-eintragen
OPENROUTER_API_KEY=hier-eintragen
INSTANTLY_API_KEY=hier-eintragen
KI_MODELL=claude-sonnet-5
# DataWarehouse-Postgres (Phase 3, 08.09.2026), deploy/docker-compose.postgres.yml.
# Nur noetig, wenn der Spiegel fuer Oliver laufen soll. Ohne diese Werte
# laeuft der Rest unveraendert weiter - die Postgres-Tests ueberspringen
# sich dann selbst.
POSTGRES_DB=coldmail
POSTGRES_USER=coldmail
POSTGRES_PASSWORD=hier-eintragen
POSTGRES_PORT=5433
# Zwei getrennte Rollen, absichtlich verschieden maechtig:
#   coldmail_sync  darf kern schreiben, historie NUR lesen und anhaengen
#   coldmail_read  darf ueberall nur lesen
COLDMAIL_SYNC_PASSWORD=hier-eintragen
COLDMAIL_READ_PASSWORD=hier-eintragen
POSTGRES_URL=postgresql://coldmail:hier-eintragen@127.0.0.1:5433/coldmail
POSTGRES_SYNC_URL=postgresql://coldmail_sync:hier-eintragen@127.0.0.1:5433/coldmail
POSTGRES_READ_URL=postgresql://coldmail_read:hier-eintragen@127.0.0.1:5433/coldmail

# Jira (jira-pp-cli). Ohne diese zwei Zeilen schreibt das Werkzeug mit dem
# Konto, das in der Maschinen-Umgebung steht - und die Eintraege stehen
# dann unter dem falschen Namen. Der Token gehoert zu JIRA_EMAIL.
JIRA_EMAIL=hier-eintragen
JIRA_API_TOKEN=hier-eintragen
